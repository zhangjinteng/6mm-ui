{
  "name": "@work-gpt/6mm-ui",
  "version": "1.0.103",
  "description": "Vue 3 component library for 6MM products",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "import": "./dist/cms.js"
    },
    "./prediction-config": {
      "types": "./dist/prediction-config/index.d.ts",
      "import": "./dist/prediction-config.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangjinteng/6mm-ui.git"
  },
  "scripts": {
    "dev": "vite playground --config vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:prediction-config": "node --import tsx --test src/prediction-config/**/*.test.mjs && vitest run src/prediction-config/runtime.test.ts",
    "test:cms": "node --import tsx --test src/cms/views/content/*.test.mjs src/cms/views/content/academy/courses/*.test.mjs src/cms/views/content/localization/translations/*.test.mjs && vitest run src/cms/*.test.ts",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "build": "vite build",
    "check": "npm run typecheck && npm test -- --run && npm run build"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.4",
    "vue": ">=3.4.0 <4"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    },
    "@element-plus/icons-vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "element-plus": "^2.9.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0"
  }
}
